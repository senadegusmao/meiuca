---
import '../styles/global.css';
import { withBase } from '../lib/url.js';
import { getContent, routes, pageKey } from '../data/i18n.js';
import PageTransition from '../components/PageTransition.astro';

interface Props {
  title?: string;
  description?: string;
  intro?: boolean;
}

const { ui } = getContent(Astro.currentLocale);
// intro: a abertura (preloader) só existe na home; nas outras páginas a
// entrada começa logo (html.no-intro)
const { title = ui.title, description = ui.description, intro = true } = Astro.props;
const page = routes[pageKey(Astro.url.pathname)];

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={ui.lang} class:list={[{ 'no-intro': !intro }]}>
  <head>
    <meta charset="utf-8" />
    <!--
      Mesma CSP dos headers (public/_headers e vercel.json), para valer também em
      hospedagens sem headers próprios, como o GitHub Pages. frame-ancestors não
      funciona em <meta> e fica só nos headers.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://hook.us2.make.com; form-action 'self'; frame-src https://player.vimeo.com; base-uri 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
    />
    <!-- Transição entre páginas: marca a chegada antes de a página aparecer -->
    <script is:inline src={withBase('/scripts/page-enter.js')}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(withBase(page.pt), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(withBase(page.en), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase(page.pt), Astro.site)} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ui.ogLocale} />
    <meta property="og:site_name" content="Meiuca" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={withBase('/fonts/archivo-latin-wght-normal.woff2')} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{ui.skip}</a>
    <PageTransition />
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
