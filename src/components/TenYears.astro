---
import { tenYears } from '../data/content.js';
import SplitChars from './SplitChars.astro';

// Módulo Marques do esrbespoke.au, sem imagem. Hierarquia em três níveis:
// a frase fixa (40px, branca) em cima; logo abaixo, a frase acesa (80px,
// branca), que completa a frase fixa; e as próximas, menores e apagadas.
// Com o scroll a lista sobe: a acesa apaga subindo e a próxima cresce no
// lugar dela. Sem JS (ou com movimento reduzido) a lista fica parada, com
// todas as frases visíveis.
---

<section class="ten" aria-labelledby="ten-title" data-phrases>
  <div class="ten__stage">
    <h2 class="ten__lead reveal-chars" id="ten-title" data-reveal><SplitChars text={tenYears.lead} /></h2>
    <ul class="ten__list reveal" role="list" data-phrase-list>
      {tenYears.phrases.map((p) => <li class="ten__item" data-phrase>{p}</li>)}
    </ul>
  </div>
</section>
