---
import { getImage } from 'astro:assets';
import Logo from '../assets/svg/logo.svg';
import reelPoster from '../assets/images/reel-poster.png';
import { getContent, homes, routes, pageKey } from '../data/i18n.js';
import { withBase } from '../lib/url.js';

const lang = Astro.currentLocale === 'en' ? 'en' : 'pt';
const { menu, reel, ui } = getContent(lang);
// A troca de língua leva para a mesma página na outra língua
const page = routes[pageKey(Astro.url.pathname)];
const poster = await getImage({ src: reelPoster, width: 1280, format: 'webp', quality: 82 });
---

<header class="site-header" data-header>
  <a href={withBase(homes[lang])} class="site-header__logo enter d1" aria-label={ui.home}>
    <Logo width="100" height="30" aria-hidden="true" />
  </a>
  <button
    class="site-header__toggle enter d2"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    data-menu-toggle
  >
    <span class="site-header__toggle-label" data-label-closed>{ui.menu}</span>
    <span class="site-header__toggle-label" data-label-open aria-hidden="true">{ui.close}</span>
  </button>
</header>

<!--
  Menu aberto: mesma estrutura e comportamento do menu do meiuca.design
  (painel que desce do topo com 672px, reel à esquerda e links à direita),
  com o fundo de vidro e o hover do joaosena.com. Com o menu aberto, o reel
  fixo do canto (Reel.astro) desce e sai da tela; ao fechar, ele volta.
-->
<div class="menu" id="menu" data-menu hidden>
  <!--
    O vidro (backdrop-filter) cresce em altura e o conteúdo desliza junto.
    Nunca anime transform num elemento com backdrop-filter: o desfoque falha.
  -->
  <div class="menu__glass" aria-hidden="true"></div>
  <div class="menu__panel">
    <div class="menu__grid">
      <div class="menu__reel">
        <button class="menu__reel-media" type="button" data-menu-reel aria-label={ui.watchReel(reel.duration)}>
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={poster.src}
            aria-hidden="true"
            tabindex="-1"
            data-reel-preview
          >
            <source data-src={withBase('/media/reel-preview.webm')} type="video/webm" />
            <source data-src={withBase('/media/reel-preview.mp4')} type="video/mp4" />
          </video>
        </button>
        <p class="menu__reel-label">{ui.playReel} - {reel.duration}</p>
      </div>

      <nav class="menu__nav" aria-label={ui.mainNav}>
        <ul class="menu__list" role="list">
          {
            menu.map((item) => (
              <li class="menu__item">
                <a class="menu__link" href={withBase(item.href)} data-menu-link>
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <!-- Troca de língua: português na raiz (/) e inglês em /en/ -->
        <div class="menu__lang" role="group" aria-label={ui.langNav}>
          <a href={withBase(page.pt)} hreflang="pt-BR" lang="pt-BR" aria-current={lang === 'pt' ? 'page' : undefined}>PT</a>
          <span aria-hidden="true">/</span>
          <a href={withBase(page.en)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        </div>
      </nav>
    </div>
  </div>
  <div class="menu__scrim" data-menu-dismiss></div>
</div>
