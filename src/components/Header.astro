---
import { getImage } from 'astro:assets';
import Logo from '../assets/svg/logo.svg';
import reelPoster from '../assets/images/reel-poster.png';
import { menu, reel } from '../data/content.js';
import { withBase } from '../lib/url.js';

const poster = await getImage({ src: reelPoster, width: 1280, format: 'webp', quality: 82 });
---

<header class="site-header" data-header>
  <a href={withBase('/')} class="site-header__logo enter d1" aria-label="Meiuca — página inicial">
    <Logo width="100" height="30" aria-hidden="true" />
  </a>
  <button
    class="site-header__toggle enter d2"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    data-menu-toggle
  >
    <span class="site-header__toggle-label" data-label-closed>Menu</span>
    <span class="site-header__toggle-label" data-label-open aria-hidden="true">Fechar</span>
  </button>
</header>

<!--
  Menu aberto: mesma estrutura e comportamento do menu do meiuca.design
  (painel que desce do topo com 672px, reel à esquerda e links à direita),
  com o fundo de vidro e o hover do joaosena.com. Com o menu aberto, o reel
  fixo do canto (Reel.astro) desce e sai da tela; ao fechar, ele volta.
-->
<div class="menu" id="menu" data-menu hidden>
  <!--
    O vidro (backdrop-filter) cresce em altura e o conteúdo desliza junto.
    Nunca anime transform num elemento com backdrop-filter: o desfoque falha.
  -->
  <div class="menu__glass" aria-hidden="true"></div>
  <div class="menu__panel">
    <div class="menu__grid">
      <div class="menu__reel">
        <button class="menu__reel-media" type="button" data-menu-reel aria-label={`Assistir ao reel da Meiuca (${reel.duration})`}>
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={poster.src}
            aria-hidden="true"
            tabindex="-1"
            data-reel-preview
          >
            <source data-src={withBase('/media/reel-preview.webm')} type="video/webm" />
            <source data-src={withBase('/media/reel-preview.mp4')} type="video/mp4" />
          </video>
        </button>
        <p class="menu__reel-label">Play reel - {reel.duration}</p>
      </div>

      <nav class="menu__nav" aria-label="Principal">
        <ul class="menu__list" role="list">
          {
            menu.map((item) => (
              <li class="menu__item">
                <a class="menu__link" href={withBase(item.href)} data-menu-link>
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
  <div class="menu__scrim" data-menu-dismiss></div>
</div>
