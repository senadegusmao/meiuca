---
import { Picture } from 'astro:assets';
import { heroText, heroImages } from '../data/content.js';
import { splitText } from '../lib/split.js';

const words = splitText(heroText);
// A entrada letra por letra dura ~1,2s qualquer que seja o tamanho do texto.
const total = words.reduce((n, w) => n + w.chars.length, 0);
const step = Math.min(0.85, 100 / total);

// Medidas do Figma (px). As imagens são geradas em vários tamanhos até 3x.
const sizes = { a: [300, 400], b: [250, 333], c: [280, 373] };

// Cada grupo repete as 5 imagens 2x para cobrir telas largas (até ~2900px).
const group = [...heroImages, ...heroImages];
---

<section class="hero" aria-label="Apresentação">
  <!-- Entrada: letra por letra com blur (Prolab), repetida quando o texto volta à tela. Cada palavra acende com o scroll. -->
  <h1 class="hero__desc" data-scroll-words data-replay>
    <span class="visually-hidden">{heroText}</span><span aria-hidden="true">{
      words.map((w) => (
        <>
          <span class="w split-word">
            {w.chars.map((c) => <span class={`enter-char d2 cd${Math.round(c.i * step)}`}>{c.ch}</span>)}
          </span>{' '}
        </>
      ))
    }</span>
  </h1>

  <!-- Marquee contínuo (Aparelho): as imagens sobem de baixo com blur, em sequência -->
  <div class="marquee" data-marquee data-replay data-header-blend>
    <div class="marquee__track">
      {
        [0, 1].map((copy) => (
          <ul class="marquee__group" aria-hidden={copy === 1 || undefined} role={copy === 0 ? 'list' : undefined}>
            {group.map((img, i) => {
              const [w, h] = sizes[img.size];
              const decorative = copy === 1 || i >= heroImages.length;
              return (
                <li class={`marquee__item marquee__item--${img.size}`}>
                  <div class={`marquee__media enter-rise d${Math.min(6 + i * 2, 40)}`}>
                    <Picture
                      src={img.src}
                      alt={decorative ? '' : img.alt}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      quality={85}
                      widths={[Math.round(w * 0.6), Math.round(w * 1.2), w, Math.round(w * 1.8), w * 2, w * 3]}
                      sizes={`(max-width: 760px) ${Math.round(w * 0.6)}px, ${w}px`}
                      width={w}
                      height={h}
                      loading={copy === 0 && i < 5 ? 'eager' : 'lazy'}
                      fetchpriority={copy === 0 && i < 3 ? 'high' : undefined}
                      decoding="async"
                    />
                  </div>
                </li>
              );
            })}
          </ul>
        ))
      }
    </div>
  </div>
</section>
