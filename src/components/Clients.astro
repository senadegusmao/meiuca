---
import { clients } from '../data/content.js';
import { withBase } from '../lib/url.js';
import SplitChars from './SplitChars.astro';

// Layout do work.co/clients: grade de 3 colunas, o título do módulo ocupa a
// primeira célula e cada cliente tem nome, descrição e link. Os links ficam
// alinhados na base de cada linha. Conteúdo em `clients`, no content.js.
---

<section class="clients" aria-labelledby="clients-title">
  <h2 class="clients__title reveal-chars" id="clients-title" data-reveal><SplitChars text="Clientes" /></h2>
  {
    clients.map((c, i) => (
      <article class={`client reveal reveal-d${(i + 1) % 3}`}>
        <h3 class="client__name">{c.name}</h3>
        <p class="client__desc">{c.description}</p>
        {c.link && (
          <a class="client__link" href={withBase(c.link.href)} aria-label={`${c.link.label}: ${c.name}`}>
            <span>{c.link.label}</span>
          </a>
        )}
      </article>
    ))
  }
</section>
